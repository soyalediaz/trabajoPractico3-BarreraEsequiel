@url=http://localhost:3000


### Login
# @name login
POST {{url}}/api/auth/login
Content-Type: application/json

{
    "email": "alediaz@gmail.com",
    "password": "43611679a"
}

### Obtener token
@token = {{login.response.body.token}}

### Mostrar todos los alumnos
GET {{url}}/api/alumnos
Authorization: Bearer {{token}}


### Mostrar un alumno por id
GET {{url}}/api/alumnos/1
Authorization: Bearer {{token}}


### Crear un alumno nuevo
POST {{url}}/api/alumnos
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Alejandro",
    "apellido": "Diaz",
    "dni": 12345678
}


### Actualizar un alumno por id
PUT {{url}}/api/alumnos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Esequiel",
    "apellido": "Barrera",
    "dni": 43611679
}


### Eliminar un alumno por id
DELETE {{url}}/api/alumnos/1
Authorization: Bearer {{token}}


